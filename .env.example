# --- Server ---
PORT=8080

# --- Microservice selector (build-time, used by npm start) ---
# MICROSERVICES=*

# --- Per-microservice runtime toggles (R4.1) ---
# Set to enabled/disabled/true/false/1/0.
MICROSERVICE_MICROSERVICE1_ENABLED=enabled
MICROSERVICE_MICROSERVICE2_ENABLED=enabled
MICROSERVICE_MICROSERVICE3_ENABLED=enabled
