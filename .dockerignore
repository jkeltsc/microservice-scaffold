# Build context exclusions.
#
# The build stage does `COPY . .` and then `npm ci`, so anything host-generated
# must stay out: a copied host node_modules/ would overlay the deterministic
# lockfile install, and stale dist/ or generated registry files would survive
# into a build that is supposed to produce them itself.
#
# Dockerfile.effective is deliberately NOT excluded: it is generated by
# scripts/emit-effective-dockerfile.sh and passed via `docker build -f`, so it
# has to be present in the context.

# Dependencies
node_modules
**/node_modules

# Build output
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Generated registry (build-tools regenerates it in the build stage)
packages/overseer/src/generated/microservice-registry.ts

# VCS and local environment
.git
.gitignore
.env
.env.*

# Editor / OS junk
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db
