# syntax=docker/dockerfile:1.7
#
# Root multi-stage Dockerfile TEMPLATE for the Microservice Scaffold.
#
# This file is NOT built directly. It is the committed source that
# scripts/emit-effective-dockerfile.sh processes into a generated `Dockerfile`
# (gitignored). The emit script fills the two `# --- MANIFEST_COPY_* ---`
# anchors below with per-workspace COPY instructions (discovered via glob-style
# listing of packages/), and injects the per-microservice default-toggle ENV
# lines (MICROSERVICE_<X>_ENABLED=enabled) before the last ENTRYPOINT.
#
# Builds a Container image that ships the Overseer plus a selected set of
# microservices. The MICROSERVICES build argument is the selector (Requirements
# R6.1/R6.2): `*` (the default) ships every discovered microservice (a
# Generic_Container); a comma-separated list ships only those identifiers (a
# Specific_Container).
#
# Stages:
#   build     - install every workspace from the committed lockfile, compile the
#               selected projects, and assemble the workspace-package staging
#               tree at /out (no node_modules). Manifests are COPYed before
#               `npm ci` so a source-only change does not bust the install
#               cache. Runs on $BUILDPLATFORM (native speed, no emulation).
#   prod-deps - a clean production-only dependency install (`npm ci --omit=dev`)
#               from the same manifests. Produces only node_modules/ — no source,
#               no compilation. Runs in parallel with `build`. Replaces the old
#               in-place `npm prune` step. Runs on $BUILDPLATFORM.
#   runtime   - minimal node:22-alpine image on the TARGET platform. Composes the
#               payload from two COPYs: third-party runtime deps from prod-deps,
#               then the workspace packages from build overlaid on top.
#               dumb-init as PID 1; runs as the unprivileged `node` user.
#
# The image ships only what was built, by construction. Its layout is:
#
#   node_modules/                       third-party runtime deps (from prod-deps)
#   node_modules/@scaffold/contracts/   real directory: package.json + dist
#   node_modules/@scaffold/<selected>/  real directories, selected services only
#   packages/overseer/                  package.json + dist
#
# Microservices live only under node_modules/@scaffold/ because the generated
# registry imports them by package name; packages/microservices/ is absent from
# the image. Adding a microservice therefore requires NO change to this file.
#
# NOTE: native-module limitation. Both installs run on $BUILDPLATFORM, so native
# addons (if any) are compiled for the build host architecture. The current
# scaffold has no native dependencies (Express is pure JS), so this is fine.
# If a microservice introduces a native dependency, the prod-deps stage would
# need to re-install production deps for the correct target arch.

# Placeholder selector: overridden per build via `--build-arg MICROSERVICES=...`.
ARG MICROSERVICES=*

# Base-image version pins: overridable via --build-arg without touching this
# file. Defaults match the versions the CI workflow forwards.
ARG NODE_VERSION=22
ARG ALPINE_VERSION=3.21

# ---------------------------------------------------------------------------
# Stage: build - install, generate, compile, assemble /out.
# Runs on the BUILD platform (native speed, no emulation for tsc / npm ci).
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS build
WORKDIR /app

ARG MICROSERVICES
ENV MICROSERVICES=${MICROSERVICES}

# --- MANIFEST_COPY_BUILD ---

# The root `prepare` lifecycle script (run by `npm ci`) copies the empty registry
# template into the generated-registry location so the Overseer has a valid
# (empty) registry to compile against. Because `npm ci` runs before `COPY . .`,
# that one source file must be present now; it is a fixed path, so it is copied
# statically here rather than via the generated manifest block.
COPY packages/overseer/src/generated/microservice-registry.template.ts packages/overseer/src/generated/

RUN --mount=type=cache,target=/root/.npm npm ci --workspaces --include-workspace-root

# All sources. Copied AFTER npm ci so a source-only change does not invalidate
# the install layer. .dockerignore keeps host node_modules/, dist/ and generated
# code out of the context, so this build is deterministic.
COPY . .

# build-tools is compiled first (alongside contracts, which the registry it
# emits imports and which is not a project reference of it), then it assembles
# the image tree.
# Everything else — registry generation, the selective tsc build, staging /out —
# happens inside build-image-tree.
RUN npx tsc --build packages/contracts packages/build-tools \
  && node packages/build-tools/dist/bin/build-image-tree.js

# ---------------------------------------------------------------------------
# Stage: prod-deps - clean production-only dependency install.
# Runs on the BUILD platform, in parallel with `build`. Produces only
# node_modules/ (no source, no compilation) — this replaces the old in-place
# `npm prune --omit=dev` step.
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS prod-deps
WORKDIR /app

# --- MANIFEST_COPY_PRODDEPS ---

# Same reason as the build stage: `npm ci` here also runs the root `prepare`
# script before any source is copied, so the registry template must be staged
# first. Fixed path, copied statically.
COPY packages/overseer/src/generated/microservice-registry.template.ts packages/overseer/src/generated/

RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --workspaces --include-workspace-root

# npm materializes the @scaffold/* workspaces as symlinks into packages/ (which
# is absent from the runtime image, so they would dangle). The real @scaffold/*
# directories come from the build stage's /out overlay, and Docker cannot COPY a
# directory over an existing symlink — so drop the workspace-scope symlinks here.
# Only third-party runtime dependencies remain to be copied from this stage.
RUN rm -rf node_modules/@scaffold

# ---------------------------------------------------------------------------
# Stage: runtime - minimal image that runs the Overseer.
# Runs on the TARGET platform (the default, no --platform override). The
# application payload is composed from two COPYs: third-party runtime deps from
# the prod-deps stage (its @scaffold/* workspace symlinks were already removed),
# then the real workspace packages from the build stage's /out on top. With the
# symlinks gone, the /out @scaffold/* directories and packages/overseer/ land
# cleanly (Docker cannot COPY a directory over an existing symlink).
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS runtime

RUN apk add --no-cache dumb-init

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

# Third-party runtime dependencies, then the workspace packages overlay.
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /out ./

# --- R6.6 toggle-default ENV injection marker ---
# scripts/emit-effective-dockerfile.sh inserts one
#   ENV MICROSERVICE_<IDENTIFIER>_ENABLED=enabled
# line per resolved identifier here (in the generated Dockerfile), before ENTRYPOINT.

EXPOSE 8080
USER node
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "packages/overseer/dist/index.js"]
