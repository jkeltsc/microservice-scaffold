{
  "name": "@scaffold/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.testing.json",
    "test": "vitest --run --passWithNoTests",
    "test:types": "vitest --run --typecheck --typecheck.tsconfig=tsconfig.test.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.testing.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
