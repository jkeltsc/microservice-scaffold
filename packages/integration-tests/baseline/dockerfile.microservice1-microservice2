  && node packages/build-tools/dist/bin/build-image-tree.js

# ---------------------------------------------------------------------------
# Stage: prod-deps - clean production-only dependency install.
# Runs on the BUILD platform, in parallel with `build`. Produces only
# node_modules/ (no source, no compilation) — this replaces the old in-place
# `npm prune --omit=dev` step.
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS prod-deps
WORKDIR /app

# An ARG declaration does not cross a stage boundary, so WORKSPACE_SCOPE must be
# re-declared here for the symlink-removal step below to see it — exactly as the
# build stage re-declares MICROSERVICES for the same reason. The default is
# repeated so a build that overrides neither arg still removes the right scope.
ARG WORKSPACE_SCOPE=@microservices

# --- manifest COPY (generated by scripts/emit-effective-dockerfile.sh) ---
COPY package.json package-lock.json ./
COPY packages/build-tools/package.json packages/build-tools/
COPY packages/contracts/package.json packages/contracts/
COPY packages/overseer/package.json packages/overseer/
COPY packages/microservices/microservice1/package.json packages/microservices/microservice1/
COPY packages/microservices/microservice2/package.json packages/microservices/microservice2/
COPY packages/microservices/microservice3/package.json packages/microservices/microservice3/
COPY packages/common/config/package.json packages/common/config/
COPY packages/common/extended-config/package.json packages/common/extended-config/
COPY packages/spa/demo/package.json packages/spa/demo/
COPY app/package.json app/

RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --workspaces --include-workspace-root

# npm materializes the @microservices/* workspaces as symlinks into packages/ (which
# is absent from the runtime image, so they would dangle). The real @microservices/*
# directories come from the build stage's /out overlay, and Docker cannot COPY a
# directory over an existing symlink — so drop the workspace-scope symlinks here.
# Only third-party runtime dependencies remain to be copied from this stage.
