# ---------------------------------------------------------------------------
# Stage: runtime - minimal image that runs the Overseer.
# Runs on the TARGET platform (the default, no --platform override). The
# application payload is composed from two COPYs: third-party runtime deps from
# the prod-deps stage (its @microservices/* workspace symlinks were already removed),
# then the real workspace packages from the build stage's /out on top. With the
# symlinks gone, the /out @microservices/* directories and packages/overseer/ land
# cleanly (Docker cannot COPY a directory over an existing symlink).
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS runtime

RUN apk add --no-cache dumb-init

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

# Third-party runtime dependencies, then the workspace packages overlay.
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /out ./

